---
import "../styles/global.css";

import { Font } from "astro:assets";
import { SEO } from "astro-seo";
import { SITE_TITLE } from "@/consts";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  templated?: boolean;
  authors?: string[];
  publishedTime?: string;
  jsonLd?: Record<string, unknown>[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const GA_MEASUREMENT_ID = "G-4W53GZ7ZZR";

const {
  title,
  templated,
  authors,
  publishedTime,
  description,
  image = "/og.jpg",
  jsonLd = [],
} = Astro.props;
---

<meta charset="utf-8" />

<script
  is:inline
  async
  src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  gtag("js", new Date());
  gtag("config", "G-4W53GZ7ZZR");
</script>

<meta name="viewport" content="width=device-width,initial-scale=1" />

<link rel="sitemap" href="/sitemap-index.xml" />

<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-outfit" preload />
<Font cssVariable="--font-damion" preload />

<SEO
  title={title}
  titleTemplate={!templated ? "%s" : `%s | ${SITE_TITLE}`}
  description={description}
  canonical={canonicalURL.href}
  openGraph={{
    basic: {
      title,
      type: "website",
      url: Astro.url,
      image: new URL(image, Astro.url).href,
    },
    optional: {
      siteName: SITE_TITLE,
      description,
    },
    article: {
      authors,
      publishedTime,
    },
  }}
  twitter={{
    card: "summary_large_image",
    title,
    description,
    image: new URL(image, Astro.url).href,
  }}
/>

{
  jsonLd.map((item) => (
    <script type="application/ld+json" set:html={JSON.stringify(item)} />
  ))
}
