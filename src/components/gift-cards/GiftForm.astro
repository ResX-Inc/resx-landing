---
import { Input } from "@/components/ui/Input";
import { Label } from "@/components/ui/Label";
import { Textarea } from "@/components/ui/Textarea";
import { ScheduleFields } from "./ScheduleFields";
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...rest } = Astro.props;

/**
 * The left column of /gift-cards/buy. Every field is uncontrolled plain HTML
 * except the schedule, which is a small island (ScheduleFields) for its
 * calendar and time slots.
 *
 * Layout: two headed sections, "Their info" (recipient, message, delivery)
 * then "Your info" (sender), with a hairline between them. Field grids are
 * two columns from `sm` up. An error sits directly under its field, above any
 * helper text, so it is the first thing read after the input.
 *
 * Every field with a rule has an error slot (`data-error-for`). The page
 * script fills them, both from its own checks on submit and from the server's
 * field errors, and finds them by attribute rather than position.
 */

const sectionClass = "flex w-full flex-col items-start gap-5";
const headingClass = "font-display text-lg leading-6 font-medium text-white";
const fieldClass = "flex min-w-0 flex-col gap-1.5";
const hintClass = "text-xs leading-4 text-zinc-300/70";
const errorClass = "text-destructive hidden text-xs leading-4";
---

<div {...rest} class={cn("flex w-full flex-col items-start gap-7", className)}>
  <p
    data-gift-error
    class="border-destructive/50 bg-destructive/10 text-destructive hidden w-full rounded-xl border px-4 py-3 text-sm leading-5"
    role="alert"
  >
  </p>

  <section aria-labelledby="gift-their-info" class={sectionClass}>
    <h2 id="gift-their-info" class={headingClass}>Their info</h2>
    <div class="grid w-full grid-cols-1 gap-x-3 gap-y-4 sm:grid-cols-2">
      <div class={fieldClass}>
        <Label htmlFor="recipientName">Their name</Label>
        <Input
          id="recipientName"
          name="recipientName"
          autoComplete="name"
          required
          placeholder="Alex Moreau"
        />
        <p data-error-for="recipientName" class={errorClass} role="alert"></p>
      </div>
      <div class={fieldClass}>
        <Label htmlFor="recipientPhone">Their phone number</Label>
        <Input
          id="recipientPhone"
          name="recipientPhone"
          type="tel"
          autoComplete="tel"
          required
          placeholder="+1 (234) 567-8900"
        />
        <p data-error-for="recipientPhone" class={errorClass} role="alert"></p>
        <p class={hintClass}>
          No ResX account needed. The text shows them how to claim it.
        </p>
      </div>

      <div class={cn(fieldClass, "sm:col-span-2")}>
        <div class="flex items-baseline justify-between gap-3">
          <Label htmlFor="message">Your message</Label>
          <span class={hintClass}>Optional</span>
        </div>
        <Textarea
          id="message"
          name="message"
          maxLength={300}
          placeholder="Happy holidays, here's to a year of great meals"
        />
        <p data-error-for="message" class={errorClass} role="alert"></p>
      </div>
    </div>

    <ScheduleFields client:load>
      <p data-error-for="sendAt" class={errorClass} role="alert"></p>
    </ScheduleFields>
  </section>

  <section
    aria-labelledby="gift-your-info"
    class={cn(sectionClass, "border-t border-white/8 pt-7")}
  >
    <h2 id="gift-your-info" class={headingClass}>Your info</h2>
    <div class="grid w-full grid-cols-1 gap-x-3 gap-y-4 sm:grid-cols-2">
      <div class={fieldClass}>
        <Label htmlFor="senderName">Your name</Label>
        <Input
          id="senderName"
          name="senderName"
          autoComplete="name"
          required
          placeholder="Jordan Lee"
        />
        <p data-error-for="senderName" class={errorClass} role="alert"></p>
      </div>
      <div class={fieldClass}>
        <Label htmlFor="senderEmail">Email for your receipt</Label>
        <Input
          id="senderEmail"
          name="senderEmail"
          type="email"
          autoComplete="email"
          required
          placeholder="hello@you.com"
        />
        <p data-error-for="senderEmail" class={errorClass} role="alert"></p>
      </div>
    </div>
  </section>
</div>
