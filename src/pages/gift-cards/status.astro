---
import {
  GiftStatus,
  type ResendOutcome,
} from "@/components/gift-cards/GiftStatus";
import {
  fetchGiftManageStatus,
  GiftApiError,
  type GiftManageStatus,
} from "@/lib/gift/api";
import { GIFT_MANAGE_COOKIE } from "@/lib/gift/manageCookie";
import { loadLargeSkinAssets } from "@/lib/gift/skinAssets";
import PageLayout from "@/layouts/PageLayout.astro";

/**
 * The manage page. The server holds this path in GIFT_MANAGE_PAGE_URL and the
 * receipt appends `?token=`, so the route must stay at /gift-cards/status.
 *
 * The token is an opaque credential and must not reach analytics. This site
 * loads gtag in <head>, and its default page_view sends `page_location` with
 * the full query string — so arriving with `?token=` would hand the token to
 * Google. Instead the token is moved straight into an HttpOnly cookie and the
 * browser is redirected to a clean URL before anything renders. As a result it
 * never appears in the address bar, in history, in a referrer header, or in
 * client-side JavaScript.
 */
const queryToken = Astro.url.searchParams.get("token");

if (queryToken) {
  Astro.cookies.set(GIFT_MANAGE_COOKIE, queryToken, {
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: "lax",
    // Must cover the resend endpoint as well as this page.
    path: "/",
    maxAge: 60 * 30,
  });
  return Astro.redirect("/gift-cards/status", 303);
}

const token = Astro.cookies.get(GIFT_MANAGE_COOKIE)?.value;
const resend = Astro.url.searchParams.get("resend");

let gift: GiftManageStatus | null = null;
let unavailable = !token;

if (token) {
  try {
    gift = await fetchGiftManageStatus(token);
  } catch (error) {
    // A bad, expired or unknown token is a flat 404 that reveals nothing, and
    // the UI must not distinguish those cases.
    if (!(error instanceof GiftApiError && error.isNotFound)) {
      const requestId = error instanceof GiftApiError ? error.requestId : null;
      console.error(
        `[gift] manage lookup failed${requestId ? ` (X-Request-Id: ${requestId})` : ""}:`,
        error instanceof Error ? error.message : error,
      );
    }
    unavailable = true;
  }
}

const RESEND_OUTCOMES: readonly ResendOutcome[] = [
  "ok",
  "conflict",
  "limited",
  "expired",
  "error",
];
const resendOutcome = RESEND_OUTCOMES.find((outcome) => outcome === resend);
const skinAssets = gift ? await loadLargeSkinAssets() : null;
---

<PageLayout
  title="Your gift | ResX"
  description="Check on a ResX Premium gift you sent."
>
  <section class="container pt-34 pb-18">
    {
      gift && skinAssets ? (
        <GiftStatus
          gift={gift}
          assets={skinAssets}
          resend={resendOutcome ?? null}
          client:load
        />
      ) : (
        <div class="bg-card/30 flex w-full max-w-150 flex-col items-start gap-4 rounded-3xl border border-white/12 p-8">
          <h1 class="font-display text-[34px] leading-[38px] font-normal tracking-[-0.68px] text-white lg:text-5xl lg:leading-[52px]">
            This link isn't valid
          </h1>
          <p class="text-base leading-6 text-white/80">
            {unavailable && !token
              ? "Open the link from your receipt email to see your gift."
              : "This link has expired or doesn't match a gift. Open the most recent link from your receipt email."}
          </p>
          <a
            href="/gift-cards"
            class="text-sand-storm text-sm leading-5 font-semibold underline-offset-4 hover:underline"
          >
            Back to gift cards
          </a>
        </div>
      )
    }
  </section>
</PageLayout>
